<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <!-- The session owns and caches the registry it hands out; a copy per call would defeat the cache -->
    <Match>
        <Class name="pro.javacard.gp.GPSession"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!-- SCP state records deliberately share key byte[] refs across state transitions; close() zeros them -->
    <Match>
        <Or>
            <Class name="pro.javacard.gp.ng.SCP01$State"/>
            <Class name="pro.javacard.gp.ng.SCP02$State"/>
            <Class name="pro.javacard.gp.ng.SCP03$State"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- SessionKeys records deliberately share key byte[] refs; close() zeros them -->
    <Match>
        <Or>
            <Class name="pro.javacard.gp.ng.SessionKeys$SCP01Keys"/>
            <Class name="pro.javacard.gp.ng.SessionKeys$SCP02Keys"/>
            <Class name="pro.javacard.gp.ng.SessionKeys$SCP03Keys"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
